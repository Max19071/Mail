{
  "name": "AI Mail Hub",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "AI Mail Hub",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "nohup npm run dev -- -H 0.0.0.0 > /tmp/ai-mail-hub.log 2>&1 &",
  "remoteUser": "node"
}
